{
  "description": "MailerLite-first email safety: session boundary, external-write confirmation, secret and raw-API guard, and targeted local validation.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/session_preflight.py\"", "timeout": 6}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/pre_command_guard.py\"", "timeout": 5}
        ]
      },
      {
        "matcher": "mcp__.*mailerlite.*",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/pre_mailerlite_guard.py\"", "timeout": 5}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/post_edit_validate.py\"", "timeout": 15}
        ]
      }
    ]
  }
}
